<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Tonsorium.Models"
             x:Class="Tonsorium.Views.CabelosPage"
             Title="Cabelos | TONSORIUM"
             BackgroundColor="Black">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <Button Text="← Voltar" Command="{Binding VoltarCommand}"
                    BackgroundColor="Transparent" TextColor="White"
                    BorderColor="#444444" BorderWidth="1" CornerRadius="8"
                    MinimumHeightRequest="40" Padding="12,0" FontSize="13"
                    HorizontalOptions="Start" />

            <!-- Hero -->
            <VerticalStackLayout Spacing="8" Padding="0,16">
                <Label Text="TONSORIUM · CABELOS" FontSize="11" FontAttributes="Bold"
                       TextColor="#f5a623" HorizontalTextAlignment="Center" />
                <Label Text="Encontre o estilo que combina com você." FontSize="26" FontAttributes="Bold"
                       TextColor="White" HorizontalTextAlignment="Center" />
                <Label Text="Explore diferentes tipos de cabelo, descubra estilos e encontre profissionais especializados para cuidar do seu visual."
                       TextColor="#cccccc" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- SEÇÃO 01: TIPOS DE CABELO -->
            <VerticalStackLayout Spacing="6">
                <Label Text="01 · EXPLORE" FontSize="11" FontAttributes="Bold" TextColor="#f5a623" />
                <Label Text="Tipos de cabelo" FontSize="20" FontAttributes="Bold" TextColor="White" />
                <Label Text="Toque em uma categoria para conhecer suas características e os tipos que ela reúne."
                       FontSize="12" TextColor="#cccccc" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Tipos}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:TipoCabelo">
                        <Border BackgroundColor="Black" Stroke="#555555" StrokeShape="RoundRectangle 12"
                                Padding="16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AlternarTipoCommand}"
                                    CommandParameter="{Binding Numero}" />
                            </Border.GestureRecognizers>
                            <Border.Shadow>
                                <Shadow Brush="White" Opacity="0.9" Radius="3.5" Offset="0,0" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Numero}" FontSize="10" TextColor="#aaaaaa" />
                                        <Label Text="{Binding Nome}" FontSize="16" FontAttributes="Bold" TextColor="White" />
                                        <Label Text="{Binding Descricao}" FontSize="12" TextColor="#cccccc" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Sinal}" FontSize="24"
                                           FontAttributes="Bold" TextColor="#f5a623" VerticalOptions="Center" />
                                </Grid>

                                <VerticalStackLayout Spacing="10" IsVisible="{Binding Expandido}">
                                    <BoxView HeightRequest="1" Color="#333333" />

                                    <Label Text="CARACTERÍSTICAS" FontSize="10" FontAttributes="Bold" TextColor="#f5a623" />
                                    <Label Text="{Binding Caracteristicas}" FontSize="13" TextColor="#cccccc" />

                                    <Label Text="TIPOS DENTRO DESTA CATEGORIA" FontSize="10" FontAttributes="Bold"
                                           TextColor="#f5a623" Margin="0,4,0,0" />

                                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Subtipos}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:Subtipo">
                                                <Border BackgroundColor="#111111" Stroke="#333333"
                                                        StrokeShape="RoundRectangle 10" Padding="12">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <Label Text="{Binding Codigo}" FontSize="14" FontAttributes="Bold"
                                                               TextColor="#f5a623" VerticalOptions="Start" />
                                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                            <Label Text="{Binding Nome}" FontSize="13" FontAttributes="Bold" TextColor="White" />
                                                            <Label Text="{Binding Descricao}" FontSize="12" TextColor="#cccccc" />
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- SEÇÃO 02: SISTEMA DE CURVATURA -->
            <VerticalStackLayout Spacing="6" Margin="0,8,0,0">
                <Label Text="02 · ENTENDA SEU CABELO" FontSize="11" FontAttributes="Bold" TextColor="#f5a623" />
                <Label Text="Sistema de curvatura" FontSize="20" FontAttributes="Bold" TextColor="White" />
                <Label Text="Toque em um tipo para ver as vantagens e desvantagens de cada curvatura."
                       FontSize="12" TextColor="#cccccc" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Curvaturas}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:CurvaturaCabelo">
                        <Border BackgroundColor="Black" Stroke="#555555" StrokeShape="RoundRectangle 12"
                                Padding="16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AlternarCurvaturaCommand}"
                                    CommandParameter="{Binding Numero}" />
                            </Border.GestureRecognizers>
                            <Border.Shadow>
                                <Shadow Brush="White" Opacity="0.9" Radius="3.5" Offset="0,0" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Numero}" FontSize="10" TextColor="#aaaaaa" />
                                        <Label Text="{Binding Nome}" FontSize="16" FontAttributes="Bold" TextColor="White" />
                                        <Label Text="{Binding Descricao}" FontSize="12" TextColor="#cccccc" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Sinal}" FontSize="24"
                                           FontAttributes="Bold" TextColor="#f5a623" VerticalOptions="Center" />
                                </Grid>

                                <VerticalStackLayout Spacing="12" IsVisible="{Binding Expandido}">
                                    <BoxView HeightRequest="1" Color="#333333" />

                                    <Label Text="VANTAGENS" FontSize="10" FontAttributes="Bold" TextColor="#f5a623" />
                                    <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Vantagens}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <Label Text="✓" FontSize="13" FontAttributes="Bold" TextColor="#f5a623" />
                                                    <Label Grid.Column="1" Text="{Binding}" FontSize="13" TextColor="#cccccc" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <Label Text="DESVANTAGENS" FontSize="10" FontAttributes="Bold" TextColor="#ff6b6b" Margin="0,4,0,0" />
                                    <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Desvantagens}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <Label Text="✕" FontSize="13" FontAttributes="Bold" TextColor="#ff6b6b" />
                                                    <Label Grid.Column="1" Text="{Binding}" FontSize="13" TextColor="#cccccc" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Rodapé -->
            <Button Text="Voltar para o início" Command="{Binding VoltarCommand}"
                    BackgroundColor="White" TextColor="Black" CornerRadius="8"
                    MinimumHeightRequest="48" FontSize="15" Margin="0,8,0,0" />

            <VerticalStackLayout Spacing="4" Padding="0,16">
                <Label Text="TONSORIUM" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                <Label Text="Seu cabelo. Seu estilo." FontSize="12" TextColor="#aaaaaa"
                       HorizontalTextAlignment="Center" />
                <Label Text="© 2026 TONSORIUM. Todos os direitos reservados." FontSize="11" TextColor="#aaaaaa"
                       HorizontalTextAlignment="Center" Margin="0,8,0,0" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>