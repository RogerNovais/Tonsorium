<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Tonsorium.Models"
             x:Class="Tonsorium.Views.PerfilEstabelecimento"
             Title="{Binding Perfil.Nome}"
             BackgroundColor="Black">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <Button Text="← Voltar" Command="{Binding VoltarCommand}"
                    BackgroundColor="Transparent" TextColor="White"
                    BorderColor="#444444" BorderWidth="1" CornerRadius="8"
                    MinimumHeightRequest="40" Padding="12,0" FontSize="13"
                    HorizontalOptions="Start" />

            <VerticalStackLayout Spacing="8" Padding="0,8">
                <Label Text="{Binding Perfil.Categoria}" FontSize="11" FontAttributes="Bold"
                       TextColor="#f5a623" HorizontalTextAlignment="Center" />
                <Label Text="{Binding Perfil.Nome}" FontSize="28" FontAttributes="Bold"
                       TextColor="White" HorizontalTextAlignment="Center" />
                <Label Text="{Binding Perfil.Estrelas}" FontSize="14" TextColor="#f5a623"
                       HorizontalTextAlignment="Center" />
                <Label Text="{Binding Perfil.Avaliacao, StringFormat='{0:0.0}'}" FontSize="12" TextColor="#cccccc"
                       HorizontalTextAlignment="Center" />
                <Label Text="{Binding Perfil.TotalAvaliacoes, StringFormat='({0} avaliações)'}" FontSize="11"
                       TextColor="#aaaaaa" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Label Text="{Binding Perfil.Descricao}" FontSize="13" TextColor="#cccccc"
                   HorizontalTextAlignment="Center" />

            <Border BackgroundColor="Black" Stroke="#555555" StrokeShape="RoundRectangle 12" Padding="16">
                <Border.Shadow>
                    <Shadow Brush="White" Opacity="0.9" Radius="3.5" Offset="0,0" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="10">
                    <Label Text="SOBRE O ESTABELECIMENTO" FontSize="10" FontAttributes="Bold" TextColor="#f5a623" />
                    <Label Text="{Binding Perfil.SobreTitulo}" FontSize="16" FontAttributes="Bold" TextColor="White" />
                    <Label Text="{Binding Perfil.SobreParagrafo1}" FontSize="13" TextColor="#cccccc" />
                    <Label Text="{Binding Perfil.SobreParagrafo2}" FontSize="13" TextColor="#cccccc" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="Black" Stroke="#555555" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="LOCALIZAÇÃO" FontSize="10" FontAttributes="Bold" TextColor="#f5a623" />
                        <Label Text="{Binding LocalizacaoCompleta}" FontSize="13" TextColor="White" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="FUNCIONAMENTO" FontSize="10" FontAttributes="Bold" TextColor="#f5a623" />
                        <Label Text="{Binding FuncionamentoCompleto}" FontSize="13" TextColor="White" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="ESPECIALIDADES" FontSize="10" FontAttributes="Bold" TextColor="#f5a623" />
                        <Label Text="{Binding EspecialidadesTexto}" FontSize="13" TextColor="White" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="10">
                <Label Text="SERVIÇOS" FontSize="11" FontAttributes="Bold" TextColor="#f5a623" />
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Perfil.Servicos}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Servico">
                            <Border BackgroundColor="#111111" Stroke="#333333" StrokeShape="RoundRectangle 10" Padding="14">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Nome}" FontSize="14" FontAttributes="Bold" TextColor="White" />
                                        <Label Text="{Binding Descricao}" FontSize="12" TextColor="#cccccc" />
                                        <Label Text="{Binding Duracao}" FontSize="11" TextColor="#aaaaaa" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Preco}" FontSize="14" FontAttributes="Bold"
                                           TextColor="#f5a623" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="NOSSA EQUIPE" FontSize="11" FontAttributes="Bold" TextColor="#f5a623" />
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Perfil.Equipe}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Profissional">
                            <Border BackgroundColor="#111111" Stroke="#333333" StrokeShape="RoundRectangle 10" Padding="14">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border BackgroundColor="Black" Stroke="#f5a623" StrokeShape="RoundRectangle 999"
                                            WidthRequest="44" HeightRequest="44">
                                        <Label Text="{Binding Iniciais}" FontSize="13" FontAttributes="Bold" TextColor="White"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Nome}" FontSize="15" FontAttributes="Bold" TextColor="White" />
                                        <Label Text="{Binding Cargo}" FontSize="12" TextColor="#cccccc" />
                                        <Label Text="{Binding Tags}" FontSize="12" TextColor="#f5a623" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Button Text="Agendar horário →" Command="{Binding AgendarCommand}"
                    BackgroundColor="White" TextColor="Black" CornerRadius="8"
                    MinimumHeightRequest="48" FontSize="15" FontAttributes="Bold" Margin="0,8,0,0" />

            <VerticalStackLayout Spacing="4" Padding="0,16">
                <Label Text="TONSORIUM" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                <Label Text="Conectando você ao seu próximo estilo." FontSize="12" TextColor="#aaaaaa"
                       HorizontalTextAlignment="Center" />
                <Label Text="© 2026 TONSORIUM. Todos os direitos reservados." FontSize="11" TextColor="#aaaaaa"
                       HorizontalTextAlignment="Center" Margin="0,8,0,0" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>