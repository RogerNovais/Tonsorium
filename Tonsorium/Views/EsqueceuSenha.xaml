<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tonsorium.Views.EsqueceuSenha">

    <ScrollView>
        <VerticalStackLayout BackgroundColor="Gray">

            <Frame BackgroundColor="Gray">
                <VerticalStackLayout>

                    <Label Text="Tonsorium"
                           TextColor="White"
                           FontSize="35"
                           FontFamily="Merriweather"
                           VerticalOptions="Center"/>



                    <Image Source="image_tonsorium.png"
                           HeightRequest="150"
                           WidthRequest="150"
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" 
                           Margin="40,40,40,0" >
                        <Image.GestureRecognizers>
                            <!-- O evento Tapped é disparado quando o usuário clica na imagem -->
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                        </Image.GestureRecognizers>
                    </Image>

                    <Label Text="Esqueceu a senha?"
                           TextColor="Black"
                           FontSize="35"
                           VerticalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="10"
                   Margin="5"
                   CornerRadius="30"
                   BackgroundColor="Gray">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Informe o e-mail cadastrado para receber o link de recuperação."
                           TextColor="Black"
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <Label Text="E-mail" />
                    <Entry Placeholder="Digite seu e-mail"
                           Keyboard="Email"
                           x:Name="CampoEmail"
                           TextChanged="OnEmailTextChanged"
                           BackgroundColor="White" />

                    <Label x:Name="AvisoEmail" 
                           Text="Formato de e-mail inválido (ex: usuario@email.com)" 
                           TextColor="Red" 
                           FontSize="12" 
                           IsVisible="False" />

                </VerticalStackLayout>
            </Frame>

            <Button Text="Enviar" 
                    Clicked="OnEnviarClicked"
                    HeightRequest="30"
                    WidthRequest="200"
                    BackgroundColor="Black"
                    TextColor="White"
                    TextTransform="Uppercase"
                    FontSize="20" />

            <Label x:Name="MensagemSucesso"
                   Text="Link de recuperação enviado para o seu e-mail."
                   TextColor="Green"
                   FontSize="14"
                   HorizontalOptions="Center"
                   Margin="0,10,0,0"
                   IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>